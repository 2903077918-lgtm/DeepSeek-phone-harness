// cloud-relay —— 纯 REST 控制面（Vercel 部署；wrangler 仅用于本地 dev 冒烟）
// Agent 走轮询(GET /v1/poll)，无 Durable Object/长连接。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "PROTOCOL_VERSION": 1
  },
  "d1_databases": [],
  "triggers": {
    "crons": []
  },
  "routes": [
    { "pattern": "relay.axyntara.cn", "custom_domain": true }
  ]
}
